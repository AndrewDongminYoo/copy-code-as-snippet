{
  "name": "copy-code-as-snippet",
  "displayName": "Copy Code as Snippet",
  "description": "Extension that copies the contents of the current file to the clipboard in Markdown code block format",
  "version": "1.2.0",
  "publisher": "dongminyu",
  "author": "Dongmin Yu <ydm2790@gmail.com> (https://github.com/AndrewDongminYoo)",
  "license": "MIT",
  "icon": "images/COPY.png",
  "engines": {
    "vscode": "^1.106.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewDongminYoo/copy-code-as-snippet"
  },
  "bugs": {
    "url": "https://github.com/AndrewDongminYoo/copy-code-as-snippet/issues",
    "email": "ydm2790@gmail.com"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-code-as-snippet.copy",
        "title": "Copy Code as Snippet"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "copy-code-as-snippet.copy",
          "when": "editorTextFocus"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copy-code-as-snippet.copy",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Copy Code as Snippet",
      "properties": {
        "copy-code-as-snippet.includeFilePath": {
          "type": "boolean",
          "default": true,
          "description": "Whether to include the file path in the snippet"
        },
        "copy-code-as-snippet.format": {
          "type": "string",
          "enum": [
            "markdown",
            "plain",
            "html"
          ],
          "default": "markdown",
          "description": "Code snippet format (markdown, plain, html)"
        },
        "copy-code-as-snippet.aiMode.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Produce AI-friendly Markdown snippets with header metadata for file/language/range"
        },
        "copy-code-as-snippet.markdown.fenceStrategy": {
          "type": "string",
          "enum": [
            "default",
            "autoUpgrade",
            "tilde"
          ],
          "default": "default",
          "description": "Markdown fence style: keep default, auto-upgrade to four backticks when content contains ``` , or always use ~~~"
        },
        "copy-code-as-snippet.markdown.pathPlacement": {
          "type": "string",
          "enum": [
            "legacy",
            "header"
          ],
          "default": "legacy",
          "description": "Place the file path in the legacy opening fence or in a standard Markdown header"
        },
        "copy-code-as-snippet.outsideWorkspacePath": {
          "type": "string",
          "enum": [
            "absolute",
            "basename"
          ],
          "default": "absolute",
          "description": "Use an absolute path or only the file name for documents outside a workspace"
        },
        "copy-code-as-snippet.largeFile.lineThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 1000,
          "description": "Line count threshold to treat a file as large when prompting for head/tail sampling"
        },
        "copy-code-as-snippet.largeFile.promptEnabled": {
          "type": "boolean",
          "default": false,
          "description": "When true and lines exceed threshold, prompt to copy full file or head/tail sample"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "26.1.1",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.7.0",
    "sinon": "^22.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "resolutions": {
    "diff": ">=8.0.3",
    "serialize-javascript": "^7.0.5",
    "fast-uri": "^3.1.4"
  }
}
